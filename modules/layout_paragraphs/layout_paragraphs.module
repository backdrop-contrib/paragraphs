/**
 * Implements hook_admin_paths().
 */
function layout_paragraphs_admin_paths() {
  // Re-use the node admin theme setting.
  if (config_get('system.core', 'node_admin_theme')) {
    $paths = array(
      'layout_paragraphs/template_change/*' => TRUE,
      'layout_paragraphs/reset/*' => TRUE,
    );
  }
  return $paths ?? [];
}


/**
 * Implements hook_library_info().
 */
function layout_paragraphs_library_info() {
  $libraries['layout_paragraphs'] = array(
    'title' => 'Layout Paragraphs',
    'version' => '1.0',
    'css' => array(
      backdrop_get_path('module', 'layout') . '/css/layout.admin.css' => array(),
      backdrop_get_path('module', 'layout_paragraphs') . '/css/layout_paragraphs.css' => array(),
    ),
    'js' => array(
      backdrop_get_path('module', 'layout') . '/js/layout.admin.js' => array(),
    ),
    'dependencies' => array(
      array('system', 'backdrop.ajax'),
      array('system', 'ui.sortable'),
    ),
  );
  return $libraries;
}

/**
 * Menu loader to load a layout instance and retrieve an individual Paragraphs
 * block from it.
 *
 * @param string $layout_block_uuid
 *   The UUID of the block to load.
 *
 * @param string $layout_name
 *   The layout instance to load the block from.
 *
 */
function layout_paragraphs_tempstore_block_load(string $layout_block_uuid, string $layout_name) {
  $layout = layout_paragraphs_get_layout_tempstore($layout_name);
  if (empty($layout)) {
    $layout = layout_paragraphs_layout_load($layout_name, FALSE, 'database');
  }
  if (empty($layout)) {
    return FALSE;
  }
  $block = layout_paragraphs_tempstore_block_retrieve($layout_block_uuid, $layout);

  return $block;
}


/**
 * Menu loader to load an individual Paragraphs block from a layout instance.
 *
 * @param string $layout_block_uuid
 *   The UUID of the block to load.
 *
 * @param Layout $layout
 *   The layout instance to load the block from.
 *
 */
function layout_paragraphs_tempstore_block_retrieve(string $layout_block_uuid, Layout $layout) {
  $block = FALSE;

  if (isset($layout->in_progress['block']) && $layout->in_progress['block']->uuid === $layout_block_uuid) {
    $block = $layout->in_progress['block'];
  }
  elseif (isset($layout->content[$layout_block_uuid])) {
    $block = $layout->content[$layout_block_uuid];
  }

  return $block;
}

/**
 * Helper: Clear a layout instance from the tempstore.
 *
 * @param string $layout_name
 *   The name of the layout instance to clear.
 *
 * @return void
 */
function layout_paragraphs_clear_layout_tempstore(string $layout_name) {
  tempstore_clear_all('layout_paragraphs', $layout_name);
}

/**
 * Helper: Save a layout instance to the tempstore.
 *
 * @param Layout $layout
 *   The layout instance to save.
 *
 * @return void
 */
function layout_paragraphs_set_layout_tempstore(Layout $layout) {
  $expire = REQUEST_TIME + settings_get('form_cache_expiration', config_get('system.core', 'form_cache_expiration'));
  tempstore_set('layout_paragraphs:layout', $layout->name, $layout, $expire);
}

/**
 * Helper: Get a layout instance from the tempstore.
 *
 * @param string $layout_name
 *   The layout name of the instance to load.
 *
 * @return Layout|false
 */
function layout_paragraphs_get_layout_tempstore(string $layout_name) {
  $layout = tempstore_get('layout_paragraphs:layout', $layout_name);
  if (empty($layout)) {
    return FALSE;
  }
  return $layout;
}

/**
 * Implements hook_entity_delete().
 *
 * Remove layout_paragraphs entries when the entity is deleted.
 *
 */
function layout_paragraphs_entity_delete($entity, $entity_type) {
  $layout_paragraphs_id = db_select('layout_paragraphs', 'lp')
    ->fields('lp', array('id'))
    ->condition('entity_id', $entity->id())
    ->condition('entity_type', $entity_type)
    ->condition('bundle', $entity->bundle())
    ->execute()
    ->fetchField();
  if ($layout_paragraphs_id) {
    db_delete('layout_paragraphs')
      ->condition('id', $layout_paragraphs_id)
      ->execute();
    db_delete('layout_paragraphs_blocks')
      ->condition('lp_id', $layout_paragraphs_id)
      ->execute();
  }
}

/**
 * Load a Layout Paragraphs layout by name from the database or tempstore and
 * places any specifically added Paragraphs blocks.
 *
 * @param string $layout_paragraphs_template_name
 *   The concatenated machine name of the layout template to load.
 *   Example: 'node.page.field_layout_paragraphs.123'.
 *
 * @param bool $place_blocks
 *   Whether to place blocks in the layout.
 *
 * @param string $source
 *   The source of the layout, either 'tempstore' or 'database'.
 *
 * @return Layout
 *   The loaded layout object.
 */
function layout_paragraphs_layout_load(string $layout_paragraphs_template_name, bool $place_blocks = TRUE, string $source = 'tempstore') {
  $lp_id = '';
  module_load_include('inc', 'layout_paragraphs', 'layout_paragraphs.admin');
  list($entity_type, $bundle, $field_name, $entity_id) = explode('.', $layout_paragraphs_template_name);
  if (is_numeric($entity_id)) {
    $query = db_select('layout_paragraphs', 'lp')
      ->fields('lp')
      ->condition('lp.entity_type', $entity_type)
      ->condition('lp.bundle', $bundle)
      ->condition('lp.field_name', $field_name)
      ->condition('lp.entity_id', $entity_id);
    $result = $query->execute()->fetchAssoc();
    $template_name = $result['layout_template'];
    $lp_id = $result['id'];
  }
  if (empty($template_name)) {
    $template_name = 'default';
  }
  $config = array(
    'is_new' => TRUE,
    'layout_template_type' => 'paragraphs',
    'is_full_page' => FALSE,
    'name' => $layout_paragraphs_template_name,
  );
  $layout = new Layout($config);
  $layout->setContexts('paragraphs', layout_paragraphs_context());
  // Load the template information.
  $layout_template_info = layout_paragraphs_get_layout_template_info($template_name);
  foreach ($layout_template_info['regions'] as $region_id => $region_name) {
    // Add the regions to the layout.
    $layout->positions[$region_id] = array();
  }
  $layout->layout_template = $template_name;
  if ($place_blocks && !empty($lp_id)) {
    _layout_paragraphs_add_paragraphs_to_layout($layout, $source, $lp_id);
  }
  return $layout;
}

/**
 * Store changes to a flexible layout template in the temporary store.
 *
 * @param LayoutFlexibleTemplate $flexible_template
 *   The loaded flexible template object.
 */
function layout_paragraphs_template_tempstore_set(LayoutFlexibleTemplate $flexible_template) {
  layout_flexible_tempstore_set($flexible_template, 'paragraphs');
}

/**
 * Get a layout paragraphs template currently being edited from the tempstore.
 *
 * If a template is not yet being edited, the template will be loaded from
 * configuration.
 *
 * @param string $flexible_template_name
 *   The machine name of the flexible template to load.
 *
 * @return LayoutFlexibleTemplate
 *   The flexible template object.
 */
function layout_paragraphs_tempstore_load(string $flexible_template_name) {
  return layout_flexible_tempstore_load($flexible_template_name, 'paragraphs');
}

/**
 * Menu callback:
 * Get a layout paragraphs template instance currently being edited from the
 * tempstore.
 *
 * If an instance is not yet being edited, the instance will be loaded from
 * configuration.
 *
 * @param string $instance_name
 *   The layout name machine name of the instance to load.
 * @param bool $reload
 *   Force reload the instance from the database and skip checking the
 *   tempstore.
 *
 * @return Layout|false
 *   The Layout paragraphs instance, or false if it couldn't be loaded.
 */
function layout_paragraphs_instance_load(string $instance_name) {
  if (empty($instance_name)) {
    return NULL;
  }
  $layout = layout_paragraphs_get_layout_tempstore($instance_name);
  if (!empty($layout)) {
    return $layout;
  }
  $layout = layout_paragraphs_layout_load($instance_name, TRUE, 'database');
  if (!empty($layout)) {
    layout_paragraphs_set_layout_tempstore($layout);
    return $layout;
  }
  return FALSE;
}

/**
 * Helper to get the title of a Paragraphs layout template.
 *
 * @param object $template
 *   The object of the template to get the title for.
 */
function layout_paragraphs_template_title_callback($template) {
  return t('!name', array('!name' => $template->title));
}

/**
 * Implements hook_theme().
 */
function layout_paragraphs_theme($existing, $type, $theme, $path) {
  $base = array(
    'path' => $path . '/theme',
    'file' => 'layout_paragraphs.theme.inc',
  );
  return array(
    'layout_paragraphs_template_info' => array(
      'variables' => array('template_info' => NULL),
    ) + $base,
    'layout_paragraphs_template_style_option' => array(
      'variables' => array('row_style' => NULL),
    ) + $base,
    'layout_paragraphs_template_option' => array(
      'variables' => array('template_info' => NULL),
    ) + $base,
    'layout_paragraphs_items' => array(
      'variables' => array(
        'items' => array(),
        'layout_name' => NULL,
      ),
    ) + $base,
    'layout__paragraphs' => array(
      'variables' => array(
        'content' => NULL,
        'settings' => NULL,
        'layout' => NULL,
        'layout_template_info' => NULL,
        'renderer' => NULL,
        'attributes' => array(),
        'admin' => FALSE,
      ),
      'template' => 'layout--paragraphs',
      'path' => $path . '/templates',
      'theme path' => $path . '/templates',
      'type' => 'module',
      'base hook' => 'layout',
      'attached' => array(
        'library' => array(
          array('layout_paragraphs', 'layout_paragraphs'),
        ),
      ),
    ),
  );
}

/**
 * Implements hook_theme_registry_alter().
 *
 * Ensure the flexible layout template is registered, whether or not it is
 * being used in core layouts.
 */
function layout_paragraphs_theme_registry_alter(&$theme_registry) {
  if (!isset($theme_registry['layout__flexible'])) {
    $theme_registry['layout__flexible'] = array(
      'variables' => array(
        'content' => NULL,
        'settings' => NULL,
        'layout' => NULL,
        'layout_template_info' => NULL,
        'renderer' => NULL,
        'attributes' => array(),
        'admin' => FALSE,
      ),
      'template' => 'layout--flexible',
      'path' => backdrop_get_path('module', 'layout') . '/templates',
      'theme path' => backdrop_get_path('module', 'layout') . '/templates',
      'type' => 'module',
      'base hook' => 'layout',
    );
  }
}

/**
 * Helper to insert a new layout_paragraphs entry when one does not exist.
 *
 * @return int
 *   The ID of the new entry, or 0 if it was unsuccessful.
 */
function layout_paragraphs_entity_template_insert(int $entity_id, string $entity_type, string $bundle, string $field_name, string $selected_template) {
  $lp_id = db_insert('layout_paragraphs')
    ->fields(array(
      'entity_id' => $entity_id,
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'field_name' => $field_name,
      'module' => 'layout_paragraphs',
      'layout_template' => $selected_template,
    ))
    ->execute();
  return (!empty($lp_id) && is_numeric($lp_id)) ? $lp_id : 0;
}

