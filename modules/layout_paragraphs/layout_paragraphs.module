/**
 * Load the information of either a single Layout Paragraphs template or all
 * available Layout Paragraphs templates.
 *
 * @param string $template_name
 *   Optionally specify a name of a single Layout Paragraphs template, e.g.
 *   "default". If no template name is specified, information for all
 *   Layout Paragraphs templates will be returned.
 *
 * @param boolean $rebuild
 *   Whether the list of layout template info needs to be rebuilt (see
 *   https://github.com/backdrop/backdrop-issues/issues/984). The rebuild is
 *   required only on specific cases, so this defaults to FALSE. That way, the
 *   rest of the times the layout cache is used (when available) for performance
 *   reasons.
 *
 * @return array
 *   The Layout Paragraphs template information. We aren't using
 *   hook_layout_template_info() because we're keeping these layouts out of the
 *   main Layout UI.
 */
function layout_paragraphs_get_layout_template_info($template_name = NULL, $rebuild = FALSE) {
  $info = &backdrop_static(__FUNCTION__);

  // Try getting a cached list of layout info.
  if (!isset($info) && !$rebuild) {
    $cache = cache('cache')->get('layout_paragraphs_info');

    if ($cache && $cache->data) {
      $info = $cache->data;
    }
  }

  // Rebuild the list of layout info.
  if (!isset($info[$template_name]) || $rebuild) {
    $info = array();
    $styles = layout_flexible_row_styles();

    $layout_paragraphs_templates = layout_flexible_template_load_all('paragraphs');
    foreach ($layout_paragraphs_templates as $layout_paragraphs_template) {
      $info[$layout_paragraphs_template->name] = array(
        'title' => $layout_paragraphs_template->title,
        'name' => $layout_paragraphs_template->name,
        'regions' => array(),
        'default region' => '',
        'template' => 'layout--paragraphs',
        'path' => backdrop_get_path('module', 'layout_paragraphs') . '/templates',
        'flexible' => TRUE,
        'layout_template_type' => 'paragraphs',
        'is_full_page' => FALSE,
        'module' => 'layout_paragraphs',
        'preview' => "<svg width='50' height='75'><rect x='0' y='0' width='50' height='75' fill='rgb(102, 102, 102)' /><rect x='52' y='0' width='52' height='75' fill='rgb(102, 102, 102)' /></svg>",
      );

      foreach ($layout_paragraphs_template->rows as $row_name => $region) {
        $region_style = $styles[$region['contains']];
        for ($i = 0; $i < $region_style['region_count']; $i++) {
          if (!empty($region['region_names']['region_' . $i]['label'])) {
            $region_name = $region['region_names']['region_' . $i]['label'];
          }
          else {
            $region_name = $row_name . ' ' . $i;
          }
          $info[$layout_paragraphs_template->name]['regions'][$row_name . '--' . $i] = $region_name;
        }
      }
    }
    // Populate defaults.
    foreach ($info as $name => $layout_info) {
      $info[$name] += array(
        'hidden' => FALSE,
        'preview' => "<svg width='50' height='75'><rect x='0' y='0' width='50' height='75' fill='rgb(102, 102, 102)' /></svg>",
        'default region' => 'content',
        'stylesheets' => array(
          'all' => array(str_replace('_', '-', $name) . '.css'),
        ),
      );
      if (!isset($info[$name]['template'])) {
        $template_path = BACKDROP_ROOT . '/' . $layout_info['path'] . '/layout--' . str_replace('_', '-', $name) . '.tpl.php';

        if (is_file($template_path)) {
          $info[$name]['template'] = 'layout--' . str_replace('_', '-', $name);
        }
      }
    }

    // Sort the available layouts by display name.
    backdrop_sort($info, array('title' => SORT_STRING));

    cache('cache')->set('layout_paragraphs_info', $info);
  }

  if ($template_name) {
    if (isset($info[$template_name])) {
      return $info[$template_name];
    }
    else {
      return [];
    }
  }
  else {
    return $info;
  }
}

/**
 * Implements hook_field_update_field().
 *
 * Make changes after a Layout Paragraphs-enabled field is updated.
 */
function layout_paragraphs_field_update_field($field, $prior_field, $has_data) {
  $pause = 1;
  // @todo: update the field's layout template settings (is this needed here?)
}


/**
 * Helper to store the selected layout template and block positions from the
 * tempstore to the database, and store the values needed in the Paragraphs
 * field data table. Afterwards, clear the tempstore for this layout.
 *
 * @param Entity $entity
 *   The entity being saved.
 * @param string $layout_name
 *   The name of the layout instance being used, if known.
 *
 * @return void
 */
function layout_paragraphs_store_field_data(Entity $entity, string $layout_name = '') {
  list($entity_type, $bundle, $field_name, $entity_id) = explode('.', $layout_name);
  $layout = layout_paragraphs_get_layout_tempstore($layout_name);
  // Check if this entity already has a layout_paragraphs entry.
  $result = db_select('layout_paragraphs', 'lp')
    ->fields('lp')
    ->condition('lp.entity_id', $entity_id)
    ->condition('lp.entity_type', $entity_type)
    ->condition('lp.bundle', $bundle)
    ->condition('lp.field_name', $field_name)
    ->execute()
    ->fetchAssoc();

  if (!empty($result)) {
    $lp_id = $result['id'];
    db_update('layout_paragraphs')
      ->fields(array(
        'layout_template' => $layout->layout_template,
      ))
      ->condition('id', $lp_id)
      ->execute();
  }
  elseif (!empty($entity_id)) {
    $lp_id = layout_paragraphs_entity_template_insert($entity_id, $entity_type, $bundle, $field_name, $layout->layout_template);
  }
  if (!empty($layout)) {
    foreach ($layout->positions as $region_id => $uuids) {
      foreach ($uuids as $block_index => $uuid) {
        if (!empty($uuid)) {
          // Load block with Paragraphs item attached from tempstore.
          $block = layout_paragraphs_tempstore_block_retrieve($uuid, $layout);
          if (!empty($block->paragraphs_item)) {
            if ($block->paragraphs_item->is_new) {
              $block->paragraphs_item->setHostEntity($entity_type, $entity);
              $block->paragraphs_item->being_edited = FALSE;
              $block->paragraphs_item->is_new = FALSE;
              $block->paragraphs_item->save();
            }
            $block_data = json_encode([
              'layout_name' => $layout_name,
            ]);
            $block_info = [
              'lp_id' => $lp_id,
              'paragraphs_item_id' => $block->paragraphs_item->item_id,
              'uuid' => $uuid,
              'region_id' => $region_id,
              'block_index' => $block_index,
              'block_data' => $block_data,
            ];
            $exists = db_query('SELECT count(uuid) FROM {layout_paragraphs_blocks} WHERE uuid = :uuid', array(':uuid' => $uuid))->fetchField();
            $primary_key = ($exists) ? ['uuid'] : [];
            backdrop_write_record('layout_paragraphs_blocks', $block_info, $primary_key);
          }
        }
      }
    }
  }
  layout_paragraphs_clear_layout_tempstore($layout_name);
}

/**
 * Implements hook_entity_insert().
 *
 * Handle insertion of new Paragraphs content once the entity ID has been
 * created for a new entity.
 */
function layout_paragraphs_entity_insert($entity, $entity_type) {
  if ($entity_type == 'paragraphs_item') {
    return;
  }
  $layout_name = $entity->content['layout_name'] ?? '';
  if (!empty($layout_name)) {
    list($entity_type, $bundle, $field_name, $tempstore_id) = explode('.', $layout_name);
    $insert_data = tempstore_get('layout_paragraphs_field', $tempstore_id);
    // Replace the temporary ID with the actual entity ID and update the db and
    // the tempstore before storing the data.
    $layout = layout_paragraphs_get_layout_tempstore($layout_name);
    $layout_name = _layout_paragraphs_get_layout_name($insert_data['field_instance'], $entity->id());
    $layout->name = $layout_name;
    layout_paragraphs_set_layout_tempstore($layout);
    layout_paragraphs_store_field_data($entity, $layout_name);
    tempstore_clear('layout_paragraphs_field', $tempstore_id);
  }
}

/**
 * Implements hook_entity_update().
 *
 * Store Paragraphs content for an existing entity when updated.
 */
function layout_paragraphs_entity_update($entity, $entity_type) {
  if ($entity_type == 'paragraphs_item') {
    return;
  }
  $layout_name = $entity->content['layout_name'] ?? '';
  if (!empty($layout_name)) {
    layout_paragraphs_store_field_data($entity, $layout_name);
  }
}

/**
 * Add the Paragraphs field info here in order to have it save along with
 * the host entity. This won't work for newly inserted content because we need
 * the entity ID and it doesn't exist yet in that case.
 */
function layout_paragraphs_entity_presave($entity, $entity_type) {
  if ($entity_type == 'paragraphs_item') {
    return;
  }
  $layout_name = $entity->content['layout_name'] ?? '';
  $is_new = empty($entity->id());
  $layout = layout_paragraphs_get_layout_tempstore($layout_name);
  if (!empty($layout)) {
    $field_instance = _layout_paragraphs_get_field_instance($layout_name);
    $field_name = $field_instance['field_name'] ?? '';
    $langcode = $entity->langcode;
    $delta = (!empty($entity->{$field_name}) && is_array($entity->{$field_name}[$langcode])) ? max(array_keys($entity->{$field_name}[$langcode])) + 1 : 0;
    foreach ($layout->positions as $region_id => $uuids) {
      foreach ($uuids as $block_index => $uuid) {
        if (!empty($uuid)) {
          // Load block with Paragraphs item attached from tempstore.
          $block = $layout->content[$uuid] ?? layout_paragraphs_tempstore_block_retrieve($uuid, $layout);
          if (!empty($block->paragraphs_item)) {
            $block_save_needed = FALSE;
            // Mark Paragraph items as disabled if needed.
            if ($block->status != $block->paragraphs_item->status) {
              $block->paragraphs_item->status = $block->status;
              $block_save_needed = TRUE;
            }
            if ($block->is_new || $block_save_needed) {
              $block->paragraphs_item->setHostEntity($entity_type, $entity);
              $block->paragraphs_item->being_edited = FALSE;
              $block->paragraphs_item->is_new = FALSE;
              $block->paragraphs_item->save(TRUE);
              $layout->content[$uuid]->paragraphs_item = $block->paragraphs_item;
              // Add the Paragraphs item to the entity's field data to be saved.
              $entity->{$field_name}[$langcode][$delta++] = [
                'value' => $block->paragraphs_item->item_id,
                'revision_id' => $block->paragraphs_item->revision_id,
              ];
            }
            $layout->content[$uuid] = $block;
          }
        }
      }
    }
    $deleted_block_paragraph_ids = [];
    if (!empty($layout->in_progress['deleted_blocks'])) {
      foreach ($layout->in_progress['deleted_blocks'] as $deleted_block) {
        $deleted_block_paragraph_ids[] = $deleted_block->paragraphs_item->item_id;
        $lp_id = _layout_paragraphs_get_lp_id($layout_name);
        db_delete('layout_paragraphs_blocks')
          ->condition('lp_id', $lp_id)
          ->condition('paragraphs_item_id', $deleted_block->paragraphs_item->item_id)
          ->execute();
        if ($deleted_block->paragraphs_item) {
          if ($entity->revision === 0) {
            $deleted_block->paragraphs_item->setHostEntity($entity_type, $entity);
            $deleted_block->paragraphs_item->delete();
          }
          else {
            $deleted_block->paragraphs_item->archived = 1;
            $deleted_block->paragraphs_item->save(TRUE);
          }
        }
      }
    }
    if (!empty($entity->{$field_name})) {
      // Clean up invalid block data from entity field data before saving.
      foreach ($entity->{$field_name}[$langcode] as $key => $item) {
        $paragraphs_item_id = $item['value'] ?? 0;
        if (in_array($paragraphs_item_id, $deleted_block_paragraph_ids) || (empty($paragraphs_item_id) && is_object($item['entity']))) {
          unset($entity->{$field_name}[$langcode][$key]);
        }
      }
      // Re-index the array.
      $entity->{$field_name}[$langcode] = array_values($entity->{$field_name}[$langcode]);
    }
    layout_paragraphs_set_layout_tempstore($layout);
  }
}

/**
 * Helper: return a field instance based on a Layout Paragraphs layout name.
 *
 * @param string $layout_name
 *   The name of the layout to get the field instance for.
 *
 * @return array
 *   The field instance array, or an empty array if not found.
 */
function _layout_paragraphs_get_field_instance(string $layout_name) {
  if (empty($layout_name)) {
    return [];
  }
  list($entity_type, $bundle, $field_name, $entity_id) = explode('.', $layout_name);
  if (empty($entity_type) || empty($bundle) || empty($field_name)) {
    return [];
  }
  $field_instance = field_info_instance($entity_type, $field_name, $bundle);
  return $field_instance ?? [];
}

/**
 * Helper: return a Layout Paragraphs layout name based on a field instance.
 *
 * @param array $field_instance
 *   The field instance array.
 * @param int|string $entity_id
 *   The entity ID of the layout in question, or a temporary UUID string if no
 *   entity has been saved yet and no entity ID exists.
 *
 * @return string
 *   The name of the layout based on the field instance for, or an empty string
 *   if unsuccessful.
 */
function _layout_paragraphs_get_layout_name(array $field_instance, int|string $entity_id) {
  if (empty($field_instance['entity_type'])
    || empty($field_instance['bundle'])
    || empty($field_instance['field_name'])
    || (is_numeric($entity_id) && $entity_id <= 0)) {
    // Malformed field instance.
    return '';
  }
  return $field_instance['entity_type'] . '.' . $field_instance['bundle'] . '.' . $field_instance['field_name'] . '.' . $entity_id;
}

/**
 * Helper: Get the LP Id based on the layout name.
 *
 * @param string $layout_name
 *   The name of the layout to get the LP ID for.
 *
 * @return int
 *
 */
function _layout_paragraphs_get_lp_id(string $layout_name) {
  list($entity_type, $bundle, $field_name, $entity_id) = explode('.', $layout_name);
  if (empty($entity_type) || empty($bundle) || empty($field_name) || empty($entity_id)) {
    return 0;
  }
  $query = db_select('layout_paragraphs', 'lp')
    ->fields('lp', array('id'))
    ->condition('lp.entity_type', $entity_type)
    ->condition('lp.bundle', $bundle)
    ->condition('lp.field_name', $field_name)
    ->condition('lp.entity_id', $entity_id);
  $lp_id = $query->execute()->fetchField();

  return (!empty($lp_id) && is_numeric($lp_id)) ? $lp_id : 0;
}

/**
 * Helper: Get the layout template based on the layout name.
 *
 * @param string $layout_name
 *   The name of the layout to get the LP ID for.
 *
 * @return string
 *
 */
function _layout_paragraphs_get_layout_template(string $layout_name) {
  list($entity_type, $bundle, $field_name, $entity_id) = explode('.', $layout_name);
  if (empty($entity_type) || empty($bundle) || empty($field_name) || empty($entity_id)) {
    return 0;
  }
  $query = db_select('layout_paragraphs', 'lp')
    ->fields('lp', array('layout_template'))
    ->condition('lp.entity_type', $entity_type)
    ->condition('lp.bundle', $bundle)
    ->condition('lp.field_name', $field_name)
    ->condition('lp.entity_id', $entity_id);
  $layout_template = $query->execute()->fetchField();

  return (!empty($layout_template)) ? $layout_template : 'default';
}

/**
 * Helper: Get the default region from an array of regions.
 *
 * @param array $regions
 *   The array, keyed by region names, to get the default region from.
 *
 * @return string
 *   The default region name.
 */
function _layout_paragraphs_get_default_region(array $regions) {
  $default_region = (!empty($regions['paragraphs-layout-default-template--0'])) ? 'paragraphs-layout-default-template--0' : key($regions);
  return $default_region;
}
